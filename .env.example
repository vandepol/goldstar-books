# Text generation. TEXT_PROVIDER picks who writes the words: anthropic
# (default when its key is set — the prompt was tuned against Claude) or
# openai. Either way the same validator holds the book to its level.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
# TEXT_PROVIDER=anthropic          # or: openai
# OPENAI_TEXT_MODEL=gpt-5
GENERATION_MAX_ATTEMPTS=3

# Database. SQLite is fine for local and for a first small deployment.
DATABASE_URL="file:./dev.db"

# Auth
AUTH_SECRET=            # openssl rand -base64 32
AUTH_URL=http://localhost:3000
EMAIL_SERVER=           # smtp://user:pass@host:587  (magic-link sign in)
EMAIL_FROM="Gold Star Books <hello@example.com>"

# Illustrations (optional). Default is the built-in SVG scene renderer.
# Set both to render real AI art per page via OpenAI Images — costs money.
# ART_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=gpt-image-1
